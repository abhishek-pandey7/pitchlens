# Copy to .env for local development. Defaults run fully offline.
LLM_PROVIDER=mock            # mock | groq | openai_compat (free dev) | foundry_claude | azure_openai

# Groq free tier for development (key from console.groq.com). Azure credits are kept for the final
# deployment. Defaults match the free limits; a live line that would wait > 2 s uses its template.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_QUALITY_MODEL=openai/gpt-oss-120b
GROQ_RPM=30
GROQ_TPM=8000

# Any other OpenAI-compatible endpoint (Ollama, OpenRouter, GitHub Models).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_FAST_MODEL=
OPENAI_COMPAT_QUALITY_MODEL=
OPENAI_COMPAT_STRUCTURED=json_schema   # json_schema | json_object | none
OPENAI_COMPAT_RPM=
OPENAI_COMPAT_TPM=

# Claude on Microsoft Foundry (read directly by the Anthropic SDK). Leave the key empty to use
# Microsoft Entra ID (managed identity in Azure, `az login` locally).
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
FOUNDRY_FAST_MODEL=claude-opus-5-5
FOUNDRY_QUALITY_MODEL=claude-opus-5-5
FOUNDRY_FALLBACK_MODEL=claude-opus-5

# Azure OpenAI (alternative). Leave the key empty to use Microsoft Entra ID.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_QUALITY_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

BUS=memory                   # memory | eventhubs
EVENTHUBS_NAMESPACE=
EVENTHUBS_NAME=match-events

STORE=memory                 # memory | cosmos
COSMOS_ENDPOINT=
COSMOS_DB=pitchlens

APPLICATIONINSIGHTS_CONNECTION_STRING=
LANGS=en,es,fr,pt,ar,hi

NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
