# Copy to .env for local development. Defaults run fully offline.
LLM_PROVIDER=mock            # mock | azure_openai | foundry_claude
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_QUALITY_DEPLOYMENT=
FOUNDRY_ENDPOINT=
FOUNDRY_FAST_MODEL=
FOUNDRY_QUALITY_MODEL=

BUS=memory                   # memory | eventhubs
EVENTHUBS_NAMESPACE=
EVENTHUBS_NAME=match-events

STORE=memory                 # memory | cosmos
COSMOS_ENDPOINT=
COSMOS_DB=pitchlens

APPLICATIONINSIGHTS_CONNECTION_STRING=
LANGS=en,es,fr,pt,ar,hi

NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
