# Copy to .env for local development. Defaults run fully offline.
LLM_PROVIDER=mock            # mock | foundry_claude | azure_openai

# Claude on Microsoft Foundry (read directly by the Anthropic SDK). Leave the key empty to use
# Microsoft Entra ID (managed identity in Azure, `az login` locally).
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
FOUNDRY_FAST_MODEL=claude-opus-5-5
FOUNDRY_QUALITY_MODEL=claude-opus-5-5
FOUNDRY_FALLBACK_MODEL=claude-opus-5

# Azure OpenAI (alternative). Leave the key empty to use Microsoft Entra ID.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_QUALITY_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

BUS=memory                   # memory | eventhubs
EVENTHUBS_NAMESPACE=
EVENTHUBS_NAME=match-events

STORE=memory                 # memory | cosmos
COSMOS_ENDPOINT=
COSMOS_DB=pitchlens

APPLICATIONINSIGHTS_CONNECTION_STRING=
LANGS=en,es,fr,pt,ar,hi

NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
